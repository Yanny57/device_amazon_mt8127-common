From 70e2185b04f56fe23d7b43e09ae14afd348de66e Mon Sep 17 00:00:00 2001
From: Yanny57 <duke57883@outlook.com>
Date: Fri, 23 Oct 2026 11:34:16 -0400
Subject: [PATCH 3/4] bluetooth: Fix H4 transmit for MTK STP

MTK /dev/stpbt treats every write() as one packet, so send the H4
type byte and payload in a single write instead of writev(), and
honour bt_hdr->offset in transmit_cb.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Change-Id: I05ab513a889e5dd4f6b5c017232b25c7de92072b
---
 bluetooth/1.0/default/h4_protocol.cc      | 24 ++++++++++++-----------
 bluetooth/1.0/default/vendor_interface.cc |  5 ++++-
 2 files changed, 17 insertions(+), 12 deletions(-)

diff --git a/bluetooth/1.0/default/h4_protocol.cc b/bluetooth/1.0/default/h4_protocol.cc
index 163cc33..7b34e78 100644
--- a/bluetooth/1.0/default/h4_protocol.cc
+++ b/bluetooth/1.0/default/h4_protocol.cc
@@ -19,29 +19,31 @@
 #define LOG_TAG "android.hardware.bluetooth-hci-h4"
 
 #include <errno.h>
+#include <string.h>
 #include <fcntl.h>
 #include <log/log.h>
 #include <sys/uio.h>
 #include <unistd.h>
 
+#include <vector>
+
 namespace android {
 namespace hardware {
 namespace bluetooth {
 namespace hci {
 
 size_t H4Protocol::Send(uint8_t type, const uint8_t* data, size_t length) {
-  struct iovec iov[] = {{&type, sizeof(type)},
-                        {const_cast<uint8_t*>(data), length}};
-  ssize_t ret = 0;
-  do {
-    ret = TEMP_FAILURE_RETRY(writev(uart_fd_, iov, sizeof(iov) / sizeof(iov[0])));
-  } while (-1 == ret && EAGAIN == errno);
+  // Send the packet type and the packet in a single write(): packet-oriented
+  // transports (e.g. MediaTek's /dev/stpbt) treat every write as one complete
+  // HCI packet, and writev() on them is split into one write per iovec.
+  std::vector<uint8_t> packet(length + 1);
+  packet[0] = type;
+  memcpy(packet.data() + 1, data, length);
 
-  if (ret == -1) {
-    ALOGE("%s error writing to UART (%s)", __func__, strerror(errno));
-  } else if (ret < static_cast<ssize_t>(length + 1)) {
-    ALOGE("%s: %d / %d bytes written - something went wrong...", __func__,
-          static_cast<int>(ret), static_cast<int>(length + 1));
+  size_t ret = WriteSafely(uart_fd_, packet.data(), packet.size());
+  if (ret < packet.size()) {
+    ALOGE("%s: %zu / %zu bytes written - something went wrong...", __func__,
+          ret, packet.size());
   }
   return ret;
 }
diff --git a/bluetooth/1.0/default/vendor_interface.cc b/bluetooth/1.0/default/vendor_interface.cc
index 6ce2f11..ed2f113 100644
--- a/bluetooth/1.0/default/vendor_interface.cc
+++ b/bluetooth/1.0/default/vendor_interface.cc
@@ -86,7 +86,10 @@ uint8_t transmit_cb(uint16_t opcode, void* buffer, tINT_CMD_CBACK callback) {
   internal_command.opcode = opcode;
   uint8_t type = HCI_PACKET_TYPE_COMMAND;
   HC_BT_HDR* bt_hdr = reinterpret_cast<HC_BT_HDR*>(buffer);
-  VendorInterface::get()->Send(type, bt_hdr->data, bt_hdr->len);
+  // The command starts at data + offset (as in the legacy stack); vendor
+  // libraries such as MediaTek's leave headroom before it.
+  VendorInterface::get()->Send(type, bt_hdr->data + bt_hdr->offset,
+                               bt_hdr->len);
   delete[] reinterpret_cast<uint8_t*>(buffer);
   return true;
 }
