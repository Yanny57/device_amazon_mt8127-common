From cb5f503ef510f89621ba79a1c126e183b1cfb19a Mon Sep 17 00:00:00 2001
From: Yanny57 <duke57883@outlook.com>
Date: Fri, 23 Oct 2026 11:34:16 -0400
Subject: [PATCH 1/8] sensors: Support pre-1.3 legacy sensors HALs

Emulate batch() with setDelay() and guard flush and direct channel
instead of aborting on HALs that report an older device version.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Change-Id: I8df14291c6afeb7111ad70b22de7f1c671303d3b
---
 sensors/1.0/default/Sensors.cpp | 28 ++++++++++++++++++++++------
 1 file changed, 22 insertions(+), 6 deletions(-)

diff --git a/sensors/1.0/default/Sensors.cpp b/sensors/1.0/default/Sensors.cpp
index 1100dd6..16f5e51 100644
--- a/sensors/1.0/default/Sensors.cpp
+++ b/sensors/1.0/default/Sensors.cpp
@@ -93,9 +93,13 @@ Sensors::Sensors()
         return;
     }
 
-    // Require all the old HAL APIs to be present except for injection, which
-    // is considered optional.
-    CHECK_GE(getHalDeviceVersion(), SENSORS_DEVICE_API_VERSION_1_3);
+    // Pre-1.3 HALs (e.g. the legacy MTK one on ford) only implement
+    // sensors_poll_device_t: batch is emulated with setDelay, and every field
+    // past poll() is outside their struct and must not be touched.
+    if (getHalDeviceVersion() < SENSORS_DEVICE_API_VERSION_1_3) {
+        LOG(WARNING) << "Legacy sensors HAL version 0x" << std::hex
+                     << getHalDeviceVersion() << ", emulating batch/flush";
+    }
 
     if (getHalDeviceVersion() == SENSORS_DEVICE_API_VERSION_1_4) {
         if (mSensorDevice->inject_sensor_data == nullptr) {
@@ -235,6 +239,12 @@ Return<Result> Sensors::batch(
         int32_t sensor_handle,
         int64_t sampling_period_ns,
         int64_t max_report_latency_ns) {
+    if (getHalDeviceVersion() < SENSORS_DEVICE_API_VERSION_1_3) {
+        return ResultFromStatus(
+                mSensorDevice->setDelay(
+                    reinterpret_cast<sensors_poll_device_t *>(mSensorDevice),
+                    sensor_handle, sampling_period_ns));
+    }
     return ResultFromStatus(
             mSensorDevice->batch(
                 mSensorDevice,
@@ -245,6 +255,9 @@ Return<Result> Sensors::batch(
 }
 
 Return<Result> Sensors::flush(int32_t sensor_handle) {
+    if (getHalDeviceVersion() < SENSORS_DEVICE_API_VERSION_1_3) {
+        return Result::BAD_VALUE;
+    }
     return ResultFromStatus(mSensorDevice->flush(mSensorDevice, sensor_handle));
 }
 
@@ -263,7 +276,8 @@ Return<Result> Sensors::injectSensorData(const Event& event) {
 
 Return<void> Sensors::registerDirectChannel(
         const SharedMemInfo& mem, registerDirectChannel_cb _hidl_cb) {
-    if (mSensorDevice->register_direct_channel == nullptr
+    if (getHalDeviceVersion() < SENSORS_DEVICE_API_VERSION_1_3
+            || mSensorDevice->register_direct_channel == nullptr
             || mSensorDevice->config_direct_report == nullptr) {
         // HAL does not support
         _hidl_cb(Result::INVALID_OPERATION, -1);
@@ -288,7 +302,8 @@ Return<void> Sensors::registerDirectChannel(
 }
 
 Return<Result> Sensors::unregisterDirectChannel(int32_t channelHandle) {
-    if (mSensorDevice->register_direct_channel == nullptr
+    if (getHalDeviceVersion() < SENSORS_DEVICE_API_VERSION_1_3
+            || mSensorDevice->register_direct_channel == nullptr
             || mSensorDevice->config_direct_report == nullptr) {
         // HAL does not support
         return Result::INVALID_OPERATION;
@@ -302,7 +317,8 @@ Return<Result> Sensors::unregisterDirectChannel(int32_t channelHandle) {
 Return<void> Sensors::configDirectReport(
         int32_t sensorHandle, int32_t channelHandle, RateLevel rate,
         configDirectReport_cb _hidl_cb) {
-    if (mSensorDevice->register_direct_channel == nullptr
+    if (getHalDeviceVersion() < SENSORS_DEVICE_API_VERSION_1_3
+            || mSensorDevice->register_direct_channel == nullptr
             || mSensorDevice->config_direct_report == nullptr) {
         // HAL does not support
         _hidl_cb(Result::INVALID_OPERATION, -1);
