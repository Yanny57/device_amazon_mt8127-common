From b43a55c3d7a6b905826845121b36fcdbcd6b071f Mon Sep 17 00:00:00 2001
From: Yanny57 <duke57883@outlook.com>
Date: Tue, 10 Nov 2026 23:45:13 -0500
Subject: [PATCH 4/8] bluetooth: Support MediaTek packet-oriented transports

- h4_protocol: send the packet type and the packet in one write();
  MediaTek's /dev/stpbt treats every write as a whole HCI packet, so
  writev() split each command and the combo chip firmware asserted.
- bluetooth_address: when no BDA is preset (MediaTek's vendor library
  programs the NVRAM address itself), generate one and persist it,
  as Oreo did.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Change-Id: Ib448a713e447329a22361ac5e10c93a811e3f406
---
 bluetooth/1.0/default/bluetooth_address.cc | 22 ++++++++++++++++++-
 bluetooth/1.0/default/h4_protocol.cc       | 25 +++++++++++-----------
 2 files changed, 34 insertions(+), 13 deletions(-)

diff --git a/bluetooth/1.0/default/bluetooth_address.cc b/bluetooth/1.0/default/bluetooth_address.cc
index 93a5469..d7a0740 100644
--- a/bluetooth/1.0/default/bluetooth_address.cc
+++ b/bluetooth/1.0/default/bluetooth_address.cc
@@ -19,6 +19,8 @@
 #include <cutils/properties.h>
 #include <errno.h>
 #include <fcntl.h>
+#include <stdlib.h>
+#include <time.h>
 #include <unistd.h>
 #include <utils/Log.h>
 
@@ -87,7 +89,25 @@ bool BluetoothAddress::get_local_address(uint8_t* local_addr) {
     return true;
   }
 
-  return false;
+  // No BDA anywhere (as on MediaTek devices, whose vendor library programs
+  // the NVRAM address itself): generate one and keep it, like Oreo did.
+  char bdstr[kStringLength + 1];
+  srand(time(NULL) ^ getpid());
+  local_addr[0] = 0x22;
+  local_addr[1] = 0x22;
+  local_addr[2] = (uint8_t)rand();
+  local_addr[3] = (uint8_t)rand();
+  local_addr[4] = (uint8_t)rand();
+  local_addr[5] = (uint8_t)rand();
+  bytes_to_string(local_addr, bdstr);
+
+  ALOGW("%s: No preset BDA, generated %s for %s", __func__, bdstr,
+        PERSIST_BDADDR_PROPERTY);
+  if (property_set(PERSIST_BDADDR_PROPERTY, bdstr) < 0) {
+    ALOGE("%s: Failed to set %s", __func__, PERSIST_BDADDR_PROPERTY);
+    return false;
+  }
+  return true;
 }
 
 }  // namespace implementation
diff --git a/bluetooth/1.0/default/h4_protocol.cc b/bluetooth/1.0/default/h4_protocol.cc
index 8c24f76..5ce96fc 100644
--- a/bluetooth/1.0/default/h4_protocol.cc
+++ b/bluetooth/1.0/default/h4_protocol.cc
@@ -19,30 +19,31 @@
 #define LOG_TAG "android.hardware.bluetooth-hci-h4"
 
 #include <errno.h>
+#include <string.h>
 #include <fcntl.h>
 #include <log/log.h>
 #include <sys/uio.h>
 #include <unistd.h>
 
+#include <vector>
+
 namespace android {
 namespace hardware {
 namespace bluetooth {
 namespace hci {
 
 size_t H4Protocol::Send(uint8_t type, const uint8_t* data, size_t length) {
-  struct iovec iov[] = {{&type, sizeof(type)},
-                        {const_cast<uint8_t*>(data), length}};
-  ssize_t ret = 0;
-  do {
-    ret =
-        TEMP_FAILURE_RETRY(writev(uart_fd_, iov, sizeof(iov) / sizeof(iov[0])));
-  } while (-1 == ret && EAGAIN == errno);
+  // Send the packet type and the packet in a single write(): packet-oriented
+  // transports (e.g. MediaTek's /dev/stpbt) treat every write as one complete
+  // HCI packet, and writev() on them is split into one write per iovec.
+  std::vector<uint8_t> packet(length + 1);
+  packet[0] = type;
+  memcpy(packet.data() + 1, data, length);
 
-  if (ret == -1) {
-    ALOGE("%s error writing to UART (%s)", __func__, strerror(errno));
-  } else if (ret < static_cast<ssize_t>(length + 1)) {
-    ALOGE("%s: %d / %d bytes written - something went wrong...", __func__,
-          static_cast<int>(ret), static_cast<int>(length + 1));
+  size_t ret = WriteSafely(uart_fd_, packet.data(), packet.size());
+  if (ret < packet.size()) {
+    ALOGE("%s: %zu / %zu bytes written - something went wrong...", __func__,
+          ret, packet.size());
   }
   return ret;
 }
