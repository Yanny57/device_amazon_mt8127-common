From 67fa6d608d6a45b7f45da3a8300a99a190ccdb0f Mon Sep 17 00:00:00 2001
From: Yanny57 <duke57883@outlook.com>
Date: Sat, 7 Nov 2026 19:07:21 -0500
Subject: [PATCH 3/8] bluetooth: Answer for feature pages the controller
 rejects

The MT8127 combo chip advertises one more extended feature page than it
serves. Report the rejected page as an empty last page, so host stacks
that treat the rejection as fatal (GSIs) keep working.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Change-Id: I736389436cee5eb2a97d2957d9225ce7f5b6592c
---
 bluetooth/1.0/default/vendor_interface.cc | 40 ++++++++++++++++++++++-
 bluetooth/1.0/default/vendor_interface.h  |  4 +++
 2 files changed, 43 insertions(+), 1 deletion(-)

diff --git a/bluetooth/1.0/default/vendor_interface.cc b/bluetooth/1.0/default/vendor_interface.cc
index d809313..aa9f48b 100644
--- a/bluetooth/1.0/default/vendor_interface.cc
+++ b/bluetooth/1.0/default/vendor_interface.cc
@@ -16,6 +16,8 @@
 
 #include "vendor_interface.h"
 
+#include <algorithm>
+
 #define LOG_TAG "android.hardware.bluetooth@1.0-impl"
 #include <cutils/properties.h>
 #include <utils/Log.h>
@@ -33,6 +35,9 @@ static const char* VENDOR_LIBRARY_SYMBOL_NAME =
 
 static const int INVALID_FD = -1;
 
+static const uint16_t kReadLocalExtFeatures = 0x1004;
+static const uint8_t kHciEventCommandComplete = 0x0e;
+
 namespace {
 
 using android::hardware::hidl_vec;
@@ -87,7 +92,10 @@ uint8_t transmit_cb(uint16_t opcode, void* buffer, tINT_CMD_CBACK callback) {
   internal_command.opcode = opcode;
   uint8_t type = HCI_PACKET_TYPE_COMMAND;
   HC_BT_HDR* bt_hdr = reinterpret_cast<HC_BT_HDR*>(buffer);
-  VendorInterface::get()->Send(type, bt_hdr->data, bt_hdr->len);
+  // The command starts at data + offset (as in the legacy stack); vendor
+  // libraries such as MediaTek's leave headroom before it.
+  VendorInterface::get()->Send(type, bt_hdr->data + bt_hdr->offset,
+                               bt_hdr->len);
   delete[] reinterpret_cast<uint8_t*>(buffer);
   return true;
 }
@@ -324,6 +332,11 @@ size_t VendorInterface::Send(uint8_t type, const uint8_t* data, size_t length) {
     ALOGV("%s: Sent wake before (%02x)", __func__, data[0] | (data[1] << 8));
   }
 
+  if (type == HCI_PACKET_TYPE_COMMAND && length >= 4 &&
+      (data[0] | (data[1] << 8)) == kReadLocalExtFeatures) {
+    ext_features_page = data[3];
+  }
+
   return hci_->Send(type, data, length);
 }
 
@@ -374,11 +387,36 @@ void VendorInterface::HandleIncomingEvent(const hidl_vec<uint8_t>& hci_packet) {
     tINT_CMD_CBACK saved_cb = internal_command.cb;
     internal_command.cb = nullptr;
     saved_cb(bt_hdr);
+  } else if (IsRejectedExtFeaturesPage(hci_packet)) {
+    // The MT8127 combo chip advertises one more extended feature page than it
+    // serves and rejects the last with status 0x30, which hosts treat as fatal.
+    // Answer for it: an empty page that is also the last one.
+    uint8_t page = ext_features_page;
+    ALOGW("%s: controller rejected feature page %d, reporting it empty", __func__,
+          page);
+    hidl_vec<uint8_t> fixed(16);
+    std::fill(fixed.begin(), fixed.end(), 0);
+    fixed[0] = kHciEventCommandComplete;
+    fixed[1] = fixed.size() - 2;
+    fixed[2] = hci_packet[2];  // number of allowed command packets
+    fixed[3] = kReadLocalExtFeatures & 0xff;
+    fixed[4] = kReadLocalExtFeatures >> 8;
+    fixed[5] = 0;     // status: success
+    fixed[6] = page;  // page number
+    fixed[7] = page;  // maximum page number
+    event_cb_(fixed);
   } else {
     event_cb_(hci_packet);
   }
 }
 
+bool VendorInterface::IsRejectedExtFeaturesPage(
+    const hidl_vec<uint8_t>& hci_packet) {
+  return hci_packet.size() >= 6 && hci_packet[0] == kHciEventCommandComplete &&
+         (hci_packet[3] | (hci_packet[4] << 8)) == kReadLocalExtFeatures &&
+         hci_packet[5] != 0 && ext_features_page > 0;
+}
+
 }  // namespace implementation
 }  // namespace V1_0
 }  // namespace bluetooth
diff --git a/bluetooth/1.0/default/vendor_interface.h b/bluetooth/1.0/default/vendor_interface.h
index 040f31a..d809ceb 100644
--- a/bluetooth/1.0/default/vendor_interface.h
+++ b/bluetooth/1.0/default/vendor_interface.h
@@ -57,6 +57,10 @@ class VendorInterface {
   void OnTimeout();
 
   void HandleIncomingEvent(const hidl_vec<uint8_t>& hci_packet);
+  bool IsRejectedExtFeaturesPage(const hidl_vec<uint8_t>& hci_packet);
+
+  // Page of the last HCI_Read_Local_Extended_Features command sent
+  uint8_t ext_features_page = 0;
 
   void* lib_handle_ = nullptr;
   bt_vendor_interface_t* lib_interface_ = nullptr;
