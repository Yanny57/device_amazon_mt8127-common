From 266d6ad0c04439330f551af49f90714ecdce8de2 Mon Sep 17 00:00:00 2001
From: Yanny57 <duke57883@outlook.com>
Date: Fri, 23 Oct 2026 11:34:16 -0400
Subject: [PATCH] hci: Tolerate controllers rejecting the last feature page

The MT8127 combo chip advertises more extended feature pages than it
serves and rejects the last with status 0x30. Treat the rejected page
as the end of the list instead of aborting the stack.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Change-Id: I55e5f124e1bf1ed24407862dcfad6dbaaf73bfb1
---
 hci/src/hci_packet_parser.cc | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/hci/src/hci_packet_parser.cc b/hci/src/hci_packet_parser.cc
index a6b61f0..4716a02 100644
--- a/hci/src/hci_packet_parser.cc
+++ b/hci/src/hci_packet_parser.cc
@@ -128,6 +128,16 @@ static void parse_read_local_extended_features_response(
   uint8_t* stream = read_command_complete_header(
       response, HCI_READ_LOCAL_EXT_FEATURES,
       2 + sizeof(bt_device_features_t) /* bytes after */);
+  if (stream == NULL && *page_number_ptr > 0) {
+    // Some controllers (e.g. MediaTek MT8127 combo) advertise more feature
+    // pages than they serve and reject the last one. Treat the rejected page
+    // as the end of the list instead of aborting the stack.
+    LOG_WARN(LOG_TAG, "%s: page %d rejected, using %d as the last page",
+             __func__, *page_number_ptr, *page_number_ptr - 1);
+    *max_page_number_ptr = *page_number_ptr - 1;
+    buffer_allocator->free(response);
+    return;
+  }
   CHECK(stream != NULL);
 
   STREAM_TO_UINT8(*page_number_ptr, stream);
-- 
