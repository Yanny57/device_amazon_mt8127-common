From 4b0322c4c3044dd0938b9b5d8386287604d4cc85 Mon Sep 17 00:00:00 2001
From: Yanny57 <duke57883@outlook.com>
Date: Wed, 11 Nov 2026 00:31:35 -0500
Subject: [PATCH] libhidl: only sleep for legacy HAL lookups during boot

Without an enforced VINTF manifest, getRawServiceInternal slept 1s on
every getService(). Each new app process looks up several HALs while
setting up its renderer, so cold starts took ~5s on ford. Only HALs
missing from the manifest can race a late registration, and only while
booting, so sleep just in that case.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Change-Id: I219cc00af5d26ccc0909a8821cb491cb647581e0
---
 transport/ServiceManagement.cpp | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/transport/ServiceManagement.cpp b/transport/ServiceManagement.cpp
index a7e9626..21c0134 100644
--- a/transport/ServiceManagement.cpp
+++ b/transport/ServiceManagement.cpp
@@ -758,7 +758,11 @@ sp<::android::hidl::base::V1_0::IBase> getRawServiceInternal(const std::string&
     const bool allowLegacy = !kEnforceVintfManifest || (trebleTestingOverride && kDebuggable);
     const bool vintfLegacy = (transport == Transport::EMPTY) && allowLegacy;
 
-    if (!kEnforceVintfManifest) {
+    // Without an enforced manifest, AOSP sleeps 1s on every lookup so a late
+    // legacy HAL can register. That made every app launch wait ~4s on ford.
+    // Only HALs missing from the manifest can race, and only while booting.
+    if (!kEnforceVintfManifest && transport == Transport::EMPTY &&
+        !android::base::GetBoolProperty("sys.boot_completed", false)) {
         ALOGE("getService: Potential race detected. The VINTF manifest is not being enforced. If "
               "a HAL server has a delay in starting and it is not in the manifest, it will not be "
               "retrieved. Please make sure all HALs on this device are in the VINTF manifest and "
