From c91bb2e74c76121b31fc960e3c97772056b29deb Mon Sep 17 00:00:00 2001
From: Yanny57 <duke57883@outlook.com>
Date: Thu, 12 Nov 2026 19:24:05 -0500
Subject: [PATCH 4/5] CameraClient: Deliver the HDR result of MediaTek HDR
 shots

The MTK HdrShot encodes the normal (0 EV) frame and the fused HDR
frame and sends both as MTK_CAMERA_MSG_EXT_DATA compressed images,
the HDR one last (the HAL logs IsFinalImage 0/1, but the ext data
header only carries the type and a shot index). The first JPEG won,
so HDR mode saved the normal frame. When scene-mode is hdr at
takePicture, drop the first JPEG of the shot.

Also drop the guessed is-final word: these HALs have none, the JPEG
always starts right after the index.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Change-Id: I9ea390bd4d87a3334a9cee6a3a8bdd0e6afd152c
---
 .../libcameraservice/api1/CameraClient.cpp    | 30 +++++++++++++------
 .../libcameraservice/api1/CameraClient.h      |  6 ++++
 2 files changed, 27 insertions(+), 9 deletions(-)

diff --git a/services/camera/libcameraservice/api1/CameraClient.cpp b/services/camera/libcameraservice/api1/CameraClient.cpp
index dafcb97..dfd515b 100644
--- a/services/camera/libcameraservice/api1/CameraClient.cpp
+++ b/services/camera/libcameraservice/api1/CameraClient.cpp
@@ -64,6 +64,7 @@ CameraClient::CameraClient(const sp<CameraService>& cameraService,
 
     mLongshotEnabled = false;
     mBurstCnt = 0;
+    mMtkJpegsToSkip = 0;
     LOG1("CameraClient::CameraClient X (pid %d, id %d)", callingPid, cameraId);
 }
 
@@ -685,11 +686,18 @@ status_t CameraClient::takePicture(int msgType) {
                            CAMERA_MSG_COMPRESSED_IMAGE);
 
     enableMsgType(picMsgType);
-    mBurstCnt = mHardware->getParameters().getInt("num-snaps-per-shutter");
+    CameraParameters params(mHardware->getParameters());
+    mBurstCnt = params.getInt("num-snaps-per-shutter");
     if(mBurstCnt <= 0)
         mBurstCnt = 1;
     LOG1("mBurstCnt = %d", mBurstCnt);
 
+    // The MTK HDR shot encodes the normal (0 EV) frame and the fused HDR frame
+    // and sends both as compressed images, the HDR one last (IsFinalImage).
+    const char* scene = params.get(CameraParameters::KEY_SCENE_MODE);
+    mMtkJpegsToSkip = (scene != nullptr && !strcmp(scene, CameraParameters::SCENE_MODE_HDR))
+            ? 1 : 0;
+
     return mHardware->takePicture();
 }
 
@@ -883,9 +891,10 @@ void CameraClient::notifyCallback(int32_t msgType, int32_t ext1,
 }
 
 // MTK HAL1 blobs deliver JPEGs as MTK_CAMERA_MSG_EXT_DATA: the buffer starts with
-// the ext message type, a shot index and (for multi-image shots like HDR) an
-// is-final flag, followed by the JPEG. Unwrap it into a CAMERA_MSG_COMPRESSED_IMAGE
-// that points at the JPEG inside the same heap. Returns nullptr to drop it.
+// the ext message type and a shot index, followed by the JPEG. The HAL's
+// IsFinalImage flag is not passed on, see takePicture() for HDR shots. Unwrap it
+// into a CAMERA_MSG_COMPRESSED_IMAGE that points at the JPEG inside the same heap.
+// Returns nullptr to drop it.
 static sp<IMemory> unwrapMtkCompressedImage(const sp<IMemory>& dataPtr) {
     if (dataPtr == nullptr) return nullptr;
     ssize_t offset = 0;
@@ -912,11 +921,8 @@ static sp<IMemory> unwrapMtkCompressedImage(const sp<IMemory>& dataPtr) {
                 w[0], w[1], w[2], w[3]);
         return nullptr;
     }
-    // A flag word sits between the index and the JPEG on multi-image shots.
-    bool isFinal = jpegOff < 12 || w[2] != 0;
-    ALOGI("MTK ext compressed image: index %u, jpeg at +%zu, %zu bytes, final %d",
-            w[1], jpegOff, size - jpegOff, isFinal);
-    if (!isFinal) return nullptr;
+    ALOGI("MTK ext compressed image: index %u, jpeg at +%zu, %zu bytes",
+            w[1], jpegOff, size - jpegOff);
     return new MemoryBase(heap, offset + jpegOff, size - jpegOff);
 }
 
@@ -931,6 +937,12 @@ void CameraClient::dataCallback(int32_t msgType,
     if (msgType == kMtkMsgExtData) {
         dataPtr = unwrapMtkCompressedImage(rawDataPtr);
         if (dataPtr == nullptr) return;
+        int skip = client->mMtkJpegsToSkip.load();
+        while (skip > 0 && !client->mMtkJpegsToSkip.compare_exchange_weak(skip, skip - 1)) {}
+        if (skip > 0) {
+            ALOGI("MTK ext compressed image: not the final image of this shot, dropped");
+            return;
+        }
         msgType = CAMERA_MSG_COMPRESSED_IMAGE;
         // These HALs never send a plain CAMERA_MSG_SHUTTER; the legacy camera2
         // shim needs one per capture, so deliver it ahead of the JPEG.
diff --git a/services/camera/libcameraservice/api1/CameraClient.h b/services/camera/libcameraservice/api1/CameraClient.h
index 12d6ad5..ed70a85 100644
--- a/services/camera/libcameraservice/api1/CameraClient.h
+++ b/services/camera/libcameraservice/api1/CameraClient.h
@@ -17,6 +17,8 @@
 #ifndef ANDROID_SERVERS_CAMERA_CAMERACLIENT_H
 #define ANDROID_SERVERS_CAMERA_CAMERACLIENT_H
 
+#include <atomic>
+
 #include "CameraService.h"
 
 namespace android {
@@ -186,6 +188,10 @@ private:
 
     bool                 mLongshotEnabled;
     int                  mBurstCnt;
+
+    // MTK HAL1: JPEGs of the current shot to drop before the one to deliver
+    // (an HDR shot sends the normal frame first, then the HDR result).
+    std::atomic<int>     mMtkJpegsToSkip;
 };
 
 }
