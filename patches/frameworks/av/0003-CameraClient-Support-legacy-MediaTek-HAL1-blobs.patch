 }
 
+// MTK HAL1 blobs deliver JPEGs as MTK_CAMERA_MSG_EXT_DATA: the buffer starts with
+// the ext message type, a shot index and (for multi-image shots like HDR) an
+// is-final flag, followed by the JPEG. Unwrap it into a CAMERA_MSG_COMPRESSED_IMAGE
+// that points at the JPEG inside the same heap. Returns nullptr to drop it.
+static sp<IMemory> unwrapMtkCompressedImage(const sp<IMemory>& dataPtr) {
+    if (dataPtr == nullptr) return nullptr;
+    ssize_t offset = 0;
+    size_t size = 0;
+    sp<IMemoryHeap> heap = dataPtr->getMemory(&offset, &size);
+    const uint8_t* p = static_cast<const uint8_t*>(dataPtr->unsecurePointer());
+    if (heap == nullptr || p == nullptr || size < 16) return nullptr;
+
+    uint32_t w[4];
+    memcpy(w, p, sizeof(w));
+    if (w[0] != kMtkExtDataCompressedImage) {
+        LOG1("MTK ext data type %#x ignored", w[0]);
+        return nullptr;
+    }
+    size_t jpegOff = 0;
+    for (size_t o = 4; o <= 16 && o + 2 <= size; o += 4) {
+        if (p[o] == 0xFF && p[o + 1] == 0xD8) {
+            jpegOff = o;
+            break;
+        }
+    }
+    if (jpegOff == 0) {
+        ALOGW("MTK ext compressed image without JPEG SOI (%#x %#x %#x %#x)",
+                w[0], w[1], w[2], w[3]);
+        return nullptr;
+    }
+    // A flag word sits between the index and the JPEG on multi-image shots.
+    bool isFinal = jpegOff < 12 || w[2] != 0;
+    ALOGI("MTK ext compressed image: index %u, jpeg at +%zu, %zu bytes, final %d",
+            w[1], jpegOff, size - jpegOff, isFinal);
+    if (!isFinal) return nullptr;
+    return new MemoryBase(heap, offset + jpegOff, size - jpegOff);
+}
+
 void CameraClient::dataCallback(int32_t msgType,
-        const sp<IMemory>& dataPtr, camera_frame_metadata_t *metadata, void* user) {
+        const sp<IMemory>& rawDataPtr, camera_frame_metadata_t *metadata, void* user) {
     LOG2("dataCallback(%d)", msgType);
 
     sp<CameraClient> client = getClientFromCookie(user);
     if (client.get() == nullptr) return;
 
+    sp<IMemory> dataPtr = rawDataPtr;
+    if (msgType == kMtkMsgExtData) {
+        dataPtr = unwrapMtkCompressedImage(rawDataPtr);
+        if (dataPtr == nullptr) return;
+        msgType = CAMERA_MSG_COMPRESSED_IMAGE;
+        // These HALs never send a plain CAMERA_MSG_SHUTTER; the legacy camera2
+        // shim needs one per capture, so deliver it ahead of the JPEG.
+        if ((client->mMsgEnabled & CAMERA_MSG_SHUTTER) &&
+                client->lockIfMessageWanted(CAMERA_MSG_SHUTTER)) {
+            client->handleShutter();  // releases mLock
+        }
+    }
+
     if (!client->lockIfMessageWanted(msgType)) return;
     if (dataPtr == 0 && metadata == NULL) {
         ALOGE("Null data returned in data callback");
