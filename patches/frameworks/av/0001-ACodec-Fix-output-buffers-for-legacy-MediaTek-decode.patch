From 2dd1b8dfe5b2bc8aed7f785f5e7559573705b282 Mon Sep 17 00:00:00 2001
From: Yanny57 <duke57883@outlook.com>
Date: Wed, 11 Nov 2026 15:49:11 -0500
Subject: [PATCH 1/5] ACodec: Fix output buffers for legacy MediaTek decoders

- MediaTek block formats (0x7F000001/2) are stored in 16x32 blocks and
  the MDP derives the plane layout from the buffer dimensions. Allocate
  nStride x nSliceHeight (the crop hides the padding); with the frame
  size the MDP read stalled and every video frame timed out.
- These decoders size nBufferCountActual themselves (DPB + consumer
  buffers + 3), assume the consumer holds two buffers and reject larger
  counts. Consumers that hold three (WebView) either failed to
  configure or starved the decoder. Pass the real count through the
  decoder's vendor parameter (0x7F00000E) and, if a count is still
  rejected, keep the one the component reports.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
Change-Id: Ib2fb1ed74e8296d8eeb1a6fa69dffde3f31911b7
---
 media/libstagefright/ACodec.cpp | 45 +++++++++++++++++++++++++++++++--
 1 file changed, 43 insertions(+), 2 deletions(-)

diff --git a/media/libstagefright/ACodec.cpp b/media/libstagefright/ACodec.cpp
index 4a3b32f..d55319e 100644
--- a/media/libstagefright/ACodec.cpp
+++ b/media/libstagefright/ACodec.cpp
@@ -1117,10 +1117,22 @@ status_t ACodec::setupNativeWindowSizeFormatAndUsage(
     mLastNativeWindowDataSpace = HAL_DATASPACE_UNKNOWN;
 
     ALOGV("gralloc usage: %#x(OMX) => %#x(ACodec)", omxUsage, usage);
+    OMX_U32 width = def.format.video.nFrameWidth;
+    OMX_U32 height = def.format.video.nFrameHeight;
+    // MediaTek block formats are stored in 16x32 blocks and the MDP derives the
+    // plane layout from the buffer size, so allocate the padded size (the crop
+    // hides the padding). Otherwise the MDP reads past the buffer and hangs.
+    if ((def.format.video.eColorFormat == 0x7F000001
+            || def.format.video.eColorFormat == 0x7F000002)
+            && def.format.video.nStride >= (OMX_S32)width
+            && def.format.video.nSliceHeight >= height) {
+        width = def.format.video.nStride;
+        height = def.format.video.nSliceHeight;
+    }
     return setNativeWindowSizeFormatAndUsage(
             nativeWindow,
-            def.format.video.nFrameWidth,
-            def.format.video.nFrameHeight,
+            width,
+            height,
             def.format.video.eColorFormat,
             mRotationDegrees,
             usage,
@@ -1176,6 +1188,24 @@ status_t ACodec::configureOutputBuffersFromNativeWindow(
         return err;
     }
 
+    if (mComponentName.startsWith("OMX.MTK.VIDEO.DECODER")) {
+        // MediaTek decoders size nBufferCountActual themselves (DPB + consumer
+        // buffers + 3) assuming the consumer holds two buffers, and reject
+        // larger counts. A SurfaceTexture consumer (WebView) holds three, which
+        // starved the decoder. Tell it the real number plus one spare through
+        // its vendor parameter, then read the adjusted port definition back.
+        const OMX_INDEXTYPE kIndexMtkVdecMinUndequeuedBufs = (OMX_INDEXTYPE)0x7F00000E;
+        OMX_U32 consumerBuffers = *minUndequeuedBuffers + 1;
+        if (mOMXNode->setParameter(kIndexMtkVdecMinUndequeuedBufs,
+                &consumerBuffers, sizeof(consumerBuffers)) == OK) {
+            err = mOMXNode->getParameter(
+                    OMX_IndexParamPortDefinition, &def, sizeof(def));
+            if (err != OK) {
+                return err;
+            }
+        }
+    }
+
     // FIXME: assume that surface is controlled by app (native window
     // returns the number for the case when surface is not controlled by app)
     // FIXME2: This means that minUndeqeueudBufs can be 1 larger than reported
@@ -1188,6 +1218,7 @@ status_t ACodec::configureOutputBuffersFromNativeWindow(
     // 2. try to allocate two (2) additional buffers to reduce starvation from
     //    the consumer
     //    plus an extra buffer to account for incorrect minUndequeuedBufs
+    const OMX_U32 componentBufferCount = def.nBufferCountActual;
     for (OMX_U32 extraBuffers = 2 + 1; /* condition inside loop */; extraBuffers--) {
         OMX_U32 newBufferCount =
             def.nBufferCountMin + *minUndequeuedBuffers + extraBuffers;
@@ -1204,6 +1235,16 @@ status_t ACodec::configureOutputBuffersFromNativeWindow(
                 mComponentName.c_str(), newBufferCount, err);
         /* exit condition */
         if (extraBuffers == 0) {
+            // MediaTek decoders reject counts above their own. If the vendor
+            // parameter above did not raise it enough, keep their count.
+            if (mComponentName.startsWith("OMX.MTK.")
+                    && componentBufferCount > *minUndequeuedBuffers) {
+                ALOGW("[%s] keeping the component's nBufferCountActual %u",
+                        mComponentName.c_str(), componentBufferCount);
+                def.nBufferCountActual = componentBufferCount;
+                err = OK;
+                break;
+            }
             return err;
         }
     }
