From 85a42f4e087b15f5ef4a4c22b09208d6f3dac871 Mon Sep 17 00:00:00 2001
From: Yanny57 <duke57883@outlook.com>
Date: Thu, 12 Nov 2026 19:24:05 -0500
Subject: [PATCH 5/5] CameraHardwareInterface: Survive a dead camera provider

Every HIDL call ignored its Return or converted it implicitly, and a
Return holding a transport error aborts the process. When the camera
provider died, the next client disconnect (stopPreview,
disableMsgType, ...) hit DEAD_OBJECT and took mediaserver down with
it. Check each Return, log the error and return DEAD_OBJECT or a
neutral value instead.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Change-Id: I1b5be8a776a4c0675b217a66f2b5bec7360a0a93
---
 .../device1/CameraHardwareInterface.cpp       | 91 +++++++++++--------
 1 file changed, 54 insertions(+), 37 deletions(-)

diff --git a/services/camera/libcameraservice/device1/CameraHardwareInterface.cpp b/services/camera/libcameraservice/device1/CameraHardwareInterface.cpp
index 61cada6..647e34b 100644
--- a/services/camera/libcameraservice/device1/CameraHardwareInterface.cpp
+++ b/services/camera/libcameraservice/device1/CameraHardwareInterface.cpp
@@ -26,11 +26,38 @@ using namespace hardware::camera::device::V1_0;
 using namespace hardware::camera::common::V1_0;
 using hardware::hidl_handle;
 
+// HIDL Returns abort the process when a transport error (e.g. DEAD_OBJECT
+// after the camera provider died) is ignored or converted implicitly, which
+// took mediaserver down whenever a client disconnected from a dead provider.
+// Check them here instead.
+static void hidlCheck(const hardware::Return<void>& ret, const char* fn) {
+    if (!ret.isOk()) {
+        ALOGE("%s: camera provider transport error: %s", fn, ret.description().c_str());
+    }
+}
+
+template <typename T>
+static T hidlValue(const hardware::Return<T>& ret, T fallback, const char* fn) {
+    if (!ret.isOk()) {
+        ALOGE("%s: camera provider transport error: %s", fn, ret.description().c_str());
+        return fallback;
+    }
+    return ret;
+}
+
+static status_t hidlStatus(const hardware::Return<Status>& ret, const char* fn) {
+    if (!ret.isOk()) {
+        ALOGE("%s: camera provider transport error: %s", fn, ret.description().c_str());
+        return DEAD_OBJECT;
+    }
+    return CameraProviderManager::mapToStatusT(ret);
+}
+
