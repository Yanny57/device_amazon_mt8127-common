From 34de105c97df62ec3fa06864ac6493d40d44e63c Mon Sep 17 00:00:00 2001
From: Yanny57 <duke57883@outlook.com>
Date: Fri, 23 Oct 2026 11:34:16 -0400
Subject: [PATCH] camera: Pre-cache legacy parameters on HAL1-in-mediaserver

HAL1 devices can only open one camera at a time, and lazily reading a
camera's legacy parameters opens it, evicting the camera an app has
open. Cache every camera's parameters when the service starts.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Change-Id: Ic98e5b1afeebec43da4ee6dcd9756b8556824f70
---
 services/camera/libcameraservice/CameraService.cpp | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/services/camera/libcameraservice/CameraService.cpp b/services/camera/libcameraservice/CameraService.cpp
index 3755d55..d4ec1a2 100644
--- a/services/camera/libcameraservice/CameraService.cpp
+++ b/services/camera/libcameraservice/CameraService.cpp
@@ -195,6 +195,17 @@ void CameraService::onFirstRef()
         mInitialized = true;
     }
 
+#ifdef NO_CAMERA_SERVER
+    // Legacy HAL1 devices can only open one camera at a time. Reading a camera's legacy
+    // parameters lazily opens it, which evicts whatever camera an app already has open
+    // (camera2 apps query every camera's characteristics). Cache them all up front.
+    if (mInitialized) {
+        for (int i = 0; i < mNumberOfNormalCameras; i++) {
+            initializeShimMetadata(i);
+        }
+    }
+#endif
+
     CameraService::pingCameraServiceProxy();
 }
 
